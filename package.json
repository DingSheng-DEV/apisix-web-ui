{
  "name": "apisix-web-ui",
  "productName": "APISIX Web UI",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:serve": "vite build && electron .",
    "electron:build": "vite build && electron-builder"
  },
   "build": {
    "appId": "com.example.apisix-web-ui",
    "productName": "APISIX Web UI",
    "directories": {
      "output": "build"
    },
      "files": [
    "dist/**/*",         
    "package.json",  
    "electron/main.cjs",
    "assets/**/*"     
  ],
    "win": {
      "target": "portable",
      "icon": "public/image.png"
    },
      "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "asar": false
  },
  "dependencies": {
    "element-plus": "^2.9.9",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.2",
    "axios": "^1.9.0",
    "concurrently": "^8.2.2",
    "electron": "^36.2.1",
    "electron-builder": "^24.13.3",
    "vite": "^6.3.1",
    "vite-plugin-electron": "^0.28.0"
  }
 
}
